# ==============================================================================
# PhishNet Environment Configuration
# ==============================================================================

# Application Port
PORT=3000
HOST=127.0.0.1

# Product Mode: "advisory" (consumer warnings) or "enforcement" (SaaS preflight block)
PHISHNET_MODE=enforcement

# AI Risk Analysis Engine (Optional external LLM)
# If left empty, PhishNet uses deterministic grounding & extraction fallback
MODEL_API_KEY=
MODEL_NAME=gemini-1.5-pro

# Official Arc Testnet Configuration (Circle L2 for Agentic Payments)
# Verified parameters from official Circle documentation:
# - Chain ID: 5042002 (Hex: 0x4CEF52)
# - RPC URL: https://rpc.testnet.arc.io
# - Currency Symbol: USDC (Native gas token on Arc Testnet)
# - Explorer: https://explorer.testnet.arc.io
# - Faucet: https://faucet.circle.com
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://explorer.testnet.arc.io
USDC_NATIVE_ASSET=USDC

# Development Wallet Signer (For isolated testnet demo only)
# WARNING: NEVER USE MAINNET KEYS OR KEYS HOLDING REAL USER FUNDS
TEST_WALLET_PRIVATE_KEY=
ALLOW_LIVE_TESTNET=false
